# ---------------------------------------------------------------------------
# HFM QA Calendar — environment template (no secrets committed)
# ---------------------------------------------------------------------------
# The Vercel connector has configured the runtime keys below on BOTH connected
# projects (qaactivitycalendarv2 and qaactivitycalendar), for production,
# preview and development. Vercel env vars configure the deployed Next.js app;
# they do NOT configure GitHub Actions. See docs/ENHANCEMENT-AUTOMATION.md.

# SQLite file used by the local/dev instance. On Vercel the app defaults to
# /tmp/qa-calendar.db, which is ephemeral. Use a durable Postgres/Neon adapter
# before relying on accounts, sessions or proposals in production.
# DATABASE_URL is not implemented by this application yet.
DATABASE_FILE=./data/qa-calendar.db

# 32+ char random string. Used to sign session cookies and CSRF tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A fresh per-project value is already set as a sensitive Vercel env var.
SESSION_SECRET=

# Default timezone for schedule rendering (date-only fields are timezone-free).
APP_TIMEZONE=Australia/Sydney

# Demo seed data. Set to false for a clean production instance.
SEED_DEMO_DATA=true

# AI provider. "local" runs the built-in deterministic insights engine with no
# outbound calls (default, air-gapped friendly). Set to "openai" only after the
# secret store is configured.
AI_PROVIDER=local
AI_API_KEY=

# Optional GitHub integration for the Future Enhancements vault.
# Moving to Building requires a server-side token with repository contents
# read/write access. Publishing is rejected visibly if GitHub is unavailable.
# GITHUB_TOKEN is already present as a sensitive Vercel env var; do not put a
# token value in this file. Branch protection must permit this token to write
# the configured branch, or the app's publishing API will fail visibly.
GITHUB_REPO=Raheelatta1984/QA-Activity-Calendar
GITHUB_TOKEN=

# Branch to receive approved handovers (defaults to main). Already set on v2
# and added to the qaactivitycalendar Vercel project in this pass.
GITHUB_ENHANCEMENTS_BRANCH=main

# ---------------------------------------------------------------------------
# GitHub Actions repository variables/secrets — set these in GitHub
# Settings > Secrets and variables > Actions, NOT in Vercel.
# ---------------------------------------------------------------------------
# Development uses a user-initiated Arena.ai Agent Mode handoff from the
# arena-handover issue: https://arena.ai/agent. No paid GitHub Copilot cloud
# agent, GitHub Models inference, external LLM API key or Vercel variable is
# required. GitHub Models was retired on 30 July 2026. The workflow never
# starts an Arena session itself; a user starts one from the issue URL.

# CI-gated squash merge after the exact head SHA passes the required check.
# AUTO_MERGE_ENABLED defaults to true in merge-after-ci.yml; set false to keep
# PRs for a human to merge.
AUTO_MERGE_ENABLED=true
REQUIRED_CHECK_NAME=Build and test

# Optional PAT for protected main or archive-PR creation; workflows fall back
# to github.token when unset. Supply through GitHub's secret store only.
AUTOMATION_TOKEN=

# Default cleanup deletes only the merged PR head branch when its name has one
# of these explicit prefixes. `copilot/` is retained for legacy branches only;
# no Copilot agent is used on a free plan. `arena/` is included so the merged PR
# head branch is cleaned up automatically after a session finishes; that branch
# is only deleted once it has no newer commits.
# Arena session branches named arena/<session-id> are never deleted
# automatically, and neither is a branch whose local HEAD does not match the
# merged PR head, whatever appears below.
# Setting this variable REPLACES the defaults, so list every prefix you want.
# Set CLEANUP_ALL_MERGED_BRANCHES=true to delete every fully merged,
# unprotected, non-main branch with no open PR.
BRANCH_CLEANUP_PREFIXES=copilot/,enh/,enhancement/,automation/,arena/
CLEANUP_ALL_MERGED_BRANCHES=false
