{
  "name": "hfm-qa-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered QA Activity Calendar \u2014 activities, capacity, pipeline, release governance and continuous improvement.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "import": "tsx scripts/import.ts",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/rules.test.ts tests/welcome.test.ts tests/enhancement-lifecycle.test.ts tests/enhancement-bridge.test.ts tests/enhancement-sync-job.test.mjs tests/bootstrap-resilience.test.mts tests/integration.test.mts tests/hfm-import.test.mts tests/org.test.mts tests/automation.test.mjs tests/automation-followup.test.mjs tests/releases.test.mts tests/postgres.test.mts tests/postgres-driver.test.mts tests/tenancy.test.mts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:backup": "tsx scripts/backup.ts",
    "catalogue": "tsx scripts/catalogue.ts",
    "db:embed": "node scripts/embed-migrations.mjs",
    "predev": "npm run db:embed --silent",
    "prebuild": "npm run db:embed --silent",
    "enhancement:sync": "tsx scripts/sync-docs-cli.ts",
    "enhancement:github-sync": "node scripts/enhancement-github-sync.mjs",
    "db:hfm-import": "tsx scripts/hfm-import.ts",
    "db:set-password": "tsx scripts/set-password.ts",
    "db:provision": "tsx scripts/provision-tenant.ts",
    "db:inject-tenant": "tsx scripts/inject-tenant-data.ts"
  },
  "dependencies": {
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [
    "qa",
    "calendar",
    "capacity",
    "pipeline",
    "release-governance",
    "nextjs",
    "sqlite"
  ]
}
