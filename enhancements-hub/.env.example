# ---------------------------------------------------------------------------
# Enhancements Hub — configuration
#
# The hub is intentionally dependency-free. Everything below is optional:
# unconfigured features degrade gracefully (local vault instead of GitHub,
# anonymous editor access instead of API-key auth).
# ---------------------------------------------------------------------------

# --- Standalone shell -------------------------------------------------------
HUB_PORT=4310
# SQLite database file. Default: ./data/enhancements-hub.db (or /tmp when read-only).
DATABASE_FILE=

# --- Identity ---------------------------------------------------------------
# Shared API key for write access. Sent by clients as
#   Authorization: Bearer <key>   (or X-Api-Key: <key>)
# Reads stay open unless HUB_READ_KEY is also set; set HUB_READ_KEY to lock
# reads behind the same key.
HUB_API_KEY=
HUB_READ_KEY=
# Default tenant slug used when a client does not send X-Tenant.
HUB_DEFAULT_TENANT=default
# "warn" (default) logs a notice when running without any key; "off" silences it.
HUB_AUTH_MODE=warn

# --- Storage ----------------------------------------------------------------
# Root of the local Markdown vault. Default: ./vault
# Layout: <root>/<tenant>/<application>/ENH-*.md (+ archived/)
HUB_VAULT_DIR=
# Per-request timeout for the deploy-time document reconciliation (ms).
HUB_DOC_SYNC_TIMEOUT_MS=2000
# Set to false to disable reconciliation on boot.
HUB_DOC_SYNC=true

# --- GitHub connectors ------------------------------------------------------
# Tokens are NEVER stored in the database. Each application registers the NAME
# of the environment variable that holds its token, e.g.:
#   ACME_PORTAL_TOKEN=github_pat_...
# and the application row stores token_env="ACME_PORTAL_TOKEN".
# A fallback shared token can be named here:
GITHUB_TOKEN=
